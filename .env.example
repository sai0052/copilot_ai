# LLM (OpenAI-compatible; Groq default)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=5
LLM_MAX_CONTEXT_TOKENS=8000

# Application
APP_HOST=0.0.0.0
APP_PORT=8010
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080
DATABASE_URL=sqlite:///./data/codepilot.db
LOG_LEVEL=INFO

# Agent
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_ROUNDS=10
AGENT_TASK_TIMEOUT_SECONDS=300
AGENT_REQUIRE_GIT_BRANCH=true
AGENT_SHOW_DIFF_BEFORE_APPROVE=false
CONTEXT_MAX_TOKENS=8000
FILE_MAX_BYTES=1048576
COMMAND_TIMEOUT_SECONDS=120
COMMAND_OUTPUT_MAX_BYTES=200000
ALLOWED_COMMANDS=pytest,python,python3,pip,pip3,npm,npx,node,git

# Optional embeddings (not required to run)
EMBEDDINGS_ENABLED=false
EMBEDDINGS_PROVIDER=sentence_transformers
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
